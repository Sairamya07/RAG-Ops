# ==============================================================================
# KnowRAG Application Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows PowerShell / CMD)
# 2. Replace the placeholder values below with your actual credentials.
#
# IMPORTANT SECURITY NOTICE:
# - Never commit the '.env' file containing real secrets to version control.
# - The '.env' file is protected and excluded by '.gitignore'.
# ==============================================================================

# [Required] Groq Cloud API Key
# Sign up and obtain an API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# [Optional] Groq LLM Model Selection
# Default: openai/gpt-oss-20b
# Other supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b

# [Optional] Health & Operations API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# [Optional] Streamlit Web Application Port
STREAMLIT_PORT=8501
